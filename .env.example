# Copy to .env for local development. Every key is optional locally: missing
# keys switch that service to a mock (console/in-memory), so `pnpm dev` works
# end-to-end without accounts. In production set them in Netlify →
# Site configuration → Environment variables.

# --- Claude (AI audit) ---------------------------------------------------
ANTHROPIC_API_KEY=
# Default claude-opus-5-5. Use claude-haiku-5-5 if audits time out on Netlify.
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high  (low keeps the response inside the function time limit)
ANTHROPIC_EFFORT=low

# --- Supabase (leads, audits, rate limits) -------------------------------
SUPABASE_URL=
# service_role key — server only, never expose it to the browser
SUPABASE_SERVICE_KEY=

# --- Resend (report email + internal emails) -----------------------------
RESEND_API_KEY=
RESEND_FROM=SolvyX <noreply@solvyxdigital.com>

# --- Internal alerts (lead_score >= LEAD_SCORE_ALERT) --------------------
SLACK_WEBHOOK_URL=
SALES_NOTIFY_EMAIL=contact@solvyxdigital.com
LEAD_SCORE_ALERT=70

# --- Contact form inbox --------------------------------------------------
CONTACT_TO_EMAIL=solvyxdigital@gmail.com

# --- Cal.com webhook (BOOKING_CREATED) -----------------------------------
CALCOM_WEBHOOK_SECRET=

# --- Misc -----------------------------------------------------------------
# Random string used to hash IPs before storing them (GDPR)
IP_HASH_SALT=change-me
# Total time budget for /api/audit in ms (keep below the Netlify function limit)
AUDIT_BUDGET_MS=24000
BOOKING_URL=https://cal.com/solvyxdigital/30min

# --- Web analytics (PostHog EU) --------------------------------------------
# Public project key (phc_...). Empty = no analytics and no cookie banner.
# Must be set at BUILD time in Netlify (PUBLIC_ vars are baked into the JS).
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
