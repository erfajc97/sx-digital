---
import { getDict, defaultLocale, type Locale } from '@/i18n';

/* Floating WhatsApp button. Always visible on phones (the channel most
   SMB owners use); a smaller version on desktop. It steps aside while the
   cookie or language banner is open so nothing overlaps. Clicks are tracked
   as `whatsapp_click` (section "whatsapp") by src/scripts/analytics.ts. */
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const { brand } = getDict(locale);

const number = (brand.whatsapp ?? brand.phone).replace(/\D/g, '');
const c =
  locale === 'en'
    ? { label: 'Chat on WhatsApp', text: 'Hi SolvyX! I’d like to know more about how you can help my business.' }
    : { label: 'Escríbenos por WhatsApp', text: '¡Hola SolvyX! Me gustaría saber cómo podéis ayudar a mi negocio.' };
const href = `https://wa.me/${number}?text=${encodeURIComponent(c.text)}`;
---

<aside id="whatsapp" class="wa-fab" aria-label={c.label}>
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class="wa-fab__btn press grid place-items-center rounded-full text-white"
    aria-label={c.label}
  >
    <svg viewBox="0 0 32 32" class="wa-fab__icon" aria-hidden="true" fill="currentColor">
      <path
        d="M16.04 3C8.86 3 3.03 8.82 3.03 16c0 2.3.6 4.53 1.74 6.5L3 29l6.68-1.75A12.94 12.94 0 0 0 16.04 29C23.2 29 29 23.18 29 16S23.2 3 16.04 3Zm0 23.7c-1.98 0-3.92-.53-5.61-1.53l-.4-.24-3.96 1.04 1.06-3.86-.26-.4A10.66 10.66 0 0 1 5.33 16c0-5.9 4.8-10.7 10.71-10.7 5.9 0 10.66 4.8 10.66 10.7 0 5.9-4.77 10.7-10.66 10.7Zm5.86-8c-.32-.16-1.9-.94-2.2-1.05-.29-.1-.5-.16-.72.16-.21.32-.82 1.04-1 1.26-.19.21-.37.24-.69.08-.32-.16-1.36-.5-2.59-1.6-.96-.85-1.6-1.9-1.79-2.22-.19-.32-.02-.5.14-.65.15-.15.32-.37.48-.56.16-.19.21-.32.32-.53.1-.21.05-.4-.03-.56-.08-.16-.72-1.73-.98-2.37-.26-.62-.52-.54-.72-.55h-.61c-.21 0-.56.08-.85.4-.29.32-1.12 1.09-1.12 2.66 0 1.57 1.14 3.09 1.3 3.3.16.21 2.25 3.43 5.45 4.81.76.33 1.36.53 1.82.67.77.24 1.46.21 2.01.13.61-.09 1.9-.78 2.16-1.53.27-.75.27-1.39.19-1.53-.08-.13-.29-.21-.61-.37Z"
      ></path>
    </svg>
    <span class="sr-only">WhatsApp</span>
  </a>
</aside>

<style>
  .wa-fab {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, calc(env(safe-area-inset-bottom) + 0.75rem));
    z-index: 60; /* below cookie (70), language (90) and intro (100) layers */
    transition:
      opacity 0.25s ease,
      transform 0.25s var(--ease-snappy, ease-out);
  }
  /* Classic round WhatsApp button. 52px on phones (comfortable tap
     target), 56px on desktop. */
  .wa-fab__btn {
    width: 3.25rem;
    height: 3.25rem;
    background: #25d366;
    box-shadow:
      0 8px 20px -6px rgb(37 211 102 / 0.55),
      0 2px 6px rgb(0 0 0 / 0.35);
  }
  .wa-fab__icon {
    width: 1.75rem;
    height: 1.75rem;
  }
  .wa-fab__btn:hover {
    background: #1fbe5b;
  }
  .wa-fab__btn:focus-visible {
    outline: 3px solid var(--color-brand-ring);
    outline-offset: 3px;
  }

  @media (min-width: 1024px) {
    .wa-fab__btn {
      width: 3.5rem;
      height: 3.5rem;
    }
    .wa-fab__icon {
      width: 1.9rem;
      height: 1.9rem;
    }
  }

  /* Step aside while a banner is open, and during the intro. */
  :global(body:has(#cookie-consent:not(.hidden))) .wa-fab,
  :global(body:has(#lang-suggest:not([hidden]))) .wa-fab,
  :global(body:has(.intro-gate:not(.is-done))) .wa-fab {
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-fab {
      transition: none;
    }
  }
</style>
