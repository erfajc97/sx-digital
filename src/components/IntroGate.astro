---
/* Intro gate — secuencia de bienvenida de 8 s con Solvy (sustituye al vídeo
   del robot). Bloquea la página mientras dura y se funde hacia la web.

   0,0–2,0 s  Aparece Solvy: se materializa desde el desenfoque entre partículas
   2,0–3,2 s  Se encienden los ojos: destello de lente en los LED
   3,2–4,2 s  El haz viaja hasta el logo SolvyX y estalla el resplandor azul
   4,2–8,0 s  Solvy flota junto al logo y la intro funde hacia la web

   Todo es CSS (la línea de tiempo arranca al añadir .is-playing cuando el
   render ya está decodificado). Saltable, solo en entradas reales al sitio
   (no al volver desde otra página) y omitida con prefers-reduced-motion. */
import { getDict, defaultLocale, type Locale } from '@/i18n';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const { ui, brand } = getDict(locale);

// Pseudoaleatorio determinista → mismo HTML en cada build
const rand = (i: number, n: number) => {
  const v = Math.sin(i * 12.9898 + n * 78.233) * 43758.5453;
  return Math.round((v - Math.floor(v)) * 1000) / 1000;
};
const bits = Array.from({ length: 28 }, (_, i) => ({
  char: rand(i, 1) > 0.5 ? '1' : '0',
  x: (rand(i, 2) * 100).toFixed(1),
  y: (rand(i, 3) * 100).toFixed(1),
  size: 10 + Math.round(rand(i, 4) * 8),
  delay: (rand(i, 5) * 1.6).toFixed(2),
  spark: rand(i, 6) > 0.6,
}));
---

<div id="intro-gate" class="intro-gate" role="dialog" aria-label={ui.introUi.aria} aria-modal="true">
  <div class="intro-scene" aria-hidden="true">
    <!-- partículas de código de las que se materializa Solvy -->
    <div class="intro-bits">
      {
        bits.map((b) => (
          <span
            class:list={['intro-bit', b.spark ? 'is-spark' : 'is-signal']}
            style={`left:${b.x}%;top:${b.y}%;font-size:${b.size}px;--d:${b.delay}s;`}
          >
            {b.char}
          </span>
        ))
      }
    </div>

    <div class="intro-row">
      <div class="intro-solvy">
        <div class="intro-solvy-float">
          <img id="intro-solvy-img" src="/solvy/solvy.webp" width="720" height="720" alt="" fetchpriority="high" />
          <span class="intro-eye intro-eye-l"><i></i></span>
          <span class="intro-eye intro-eye-r"><i></i></span>
        </div>
      </div>

      <span class="intro-beam"></span>

      <div class="intro-logo">
        <span class="intro-burst"></span>
        <img src={brand.logo3d} width="441" height="233" alt={brand.name} />
      </div>
    </div>

    <div class="intro-vignette"></div>
  </div>

  <!-- Skip -->
  <button id="intro-skip" type="button" class="intro-skip">
    {ui.introUi.skip}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </button>

  <!-- Progress bar -->
  <div class="intro-progress" aria-hidden="true"><span id="intro-bar"></span></div>
</div>

<style>
  .intro-gate {
    --intro: 8s;
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: var(--color-night);
    opacity: 1;
    transition: opacity 0.7s ease;
  }
  .intro-gate.is-leaving {
    opacity: 0;
  }
  .intro-gate.is-done {
    display: none;
  }

  .intro-scene {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  /* Nada se anima hasta que el render está listo (.is-playing) */
  .intro-gate:not(.is-playing) .intro-scene * {
    animation-play-state: paused !important;
  }

  /* ---------- Partículas ---------- */
  .intro-bits {
    position: absolute;
    inset: 0;
  }
  .intro-bit {
    position: absolute;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    text-shadow: 0 0 8px currentColor;
    opacity: 0;
    animation: bit-in 2.2s var(--d) ease-out both, bit-drift 6s calc(var(--d) + 2.2s) linear infinite;
  }
  .intro-bit.is-signal {
    color: var(--color-signal);
  }
  .intro-bit.is-spark {
    color: var(--color-spark);
  }

  /* ---------- Composición: Solvy + haz + logo ---------- */
  .intro-row {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .intro-row {
      flex-direction: row;
      gap: 3rem;
    }
  }

  .intro-solvy {
    position: relative;
    width: min(70vw, 22rem);
    aspect-ratio: 1;
    /* 0–2 s: se materializa desde el desenfoque */
    animation: solvy-in 2s var(--ease-snappy) both;
  }
  @media (min-width: 768px) {
    .intro-solvy {
      width: min(36vw, 26rem);
    }
  }
  .intro-solvy-float {
    position: absolute;
    inset: 0;
    /* 4,2 s →: flota junto al logo */
    animation: solvy-float 4.8s 4.2s ease-in-out infinite;
  }
  .intro-solvy img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: screen;
    mask-image: radial-gradient(closest-side, #000 72%, transparent 100%);
  }

  /* 2,0–3,2 s: los LED se encienden con destello de lente */
  .intro-eye {
    position: absolute;
    top: 42%;
    width: 13%;
    height: 9%;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(closest-side, oklch(0.98 0.04 200), oklch(0.86 0.14 200 / 0.6) 55%, transparent);
    mix-blend-mode: screen;
    opacity: 0;
    animation: eye-on 1.2s 2s ease-out both;
  }
  .intro-eye-l {
    left: 32.8%;
  }
  .intro-eye-r {
    left: 50.6%;
  }
  /* destello: estrella horizontal + vertical que se abre y se recoge */
  .intro-eye i {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 520%;
    height: 14%;
    translate: -50% -50%;
    border-radius: 999px;
    background: linear-gradient(to right, transparent, oklch(0.97 0.06 200 / 0.95), transparent);
    opacity: 0;
    animation: flare 1.2s 2.1s ease-out both;
  }
  .intro-eye i::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4%;
    height: 900%;
    translate: -50% -50%;
    border-radius: 999px;
    background: linear-gradient(to bottom, transparent, oklch(0.97 0.06 200 / 0.8), transparent);
  }

  /* 3,2–4,2 s: el haz viaja de Solvy al logo */
  .intro-beam {
    position: absolute;
    left: 50%;
    top: min(70vw, 22rem);
    width: 3px;
    height: 1.25rem;
    translate: -50% 0;
    background: linear-gradient(to bottom, var(--color-signal), var(--color-brand));
    box-shadow: 0 0 14px var(--color-signal), 0 0 30px var(--color-brand);
    border-radius: 999px;
    transform-origin: top;
    transform: scaleY(0);
    animation: beam-y 1s 3.2s var(--ease-smooth) both;
  }
  @media (min-width: 768px) {
    .intro-beam {
      left: calc(min(36vw, 26rem) * 0.72);
      top: 42%;
      width: calc(3rem + min(36vw, 26rem) * 0.28);
      height: 3px;
      translate: 0 -50%;
      background: linear-gradient(to right, var(--color-signal), var(--color-brand));
      transform-origin: left;
      transform: scaleX(0);
      animation-name: beam-x;
    }
  }

  .intro-logo {
    position: relative;
    width: min(64vw, 18rem);
    opacity: 0;
    animation: logo-in 0.9s 3.75s var(--ease-snappy) both;
  }
  @media (min-width: 768px) {
    .intro-logo {
      width: min(30vw, 24rem);
    }
  }
  .intro-logo img {
    position: relative;
    width: 100%;
    height: auto;
  }
  /* estallido de resplandor azul al llegar el haz */
  .intro-burst {
    position: absolute;
    inset: -45% -25%;
    border-radius: 50%;
    background: radial-gradient(closest-side, oklch(0.75 0.16 255 / 0.95), oklch(0.7 0.155 260 / 0.5) 45%, oklch(0.86 0.14 200 / 0.15) 70%, transparent);
    filter: blur(10px);
    opacity: 0;
    transform: scale(0.4);
    animation: burst 1.6s 3.8s ease-out both;
  }

  .intro-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 120% at 50% 45%, transparent 55%, oklch(0.07 0.02 265 / 0.55) 100%);
    pointer-events: none;
  }

  /* Skip — bottom right */
  .intro-skip {
    position: absolute;
    right: 1.25rem;
    bottom: 1.5rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    border: 1px solid oklch(1 0 0 / 0.14);
    background: oklch(0 0 0 / 0.35);
    color: oklch(1 0 0 / 0.72);
    font-size: 0.8rem;
    font-weight: 500;
    backdrop-filter: blur(6px);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .intro-skip:hover {
    color: #fff;
    border-color: oklch(1 0 0 / 0.35);
  }

  /* Progress bar — bottom edge, recorre los 8 s */
  .intro-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: oklch(1 0 0 / 0.1);
    z-index: 2;
  }
  #intro-bar {
    display: block;
    height: 100%;
    background: var(--gradient-neon);
    box-shadow: 0 0 12px oklch(0.86 0.14 200 / 0.7);
    transform-origin: left;
    transform: scaleX(0);
  }
  .intro-gate.is-playing #intro-bar {
    animation: progress var(--intro) linear both;
  }

  /* ---------- Keyframes ---------- */
  @keyframes bit-in {
    0% { opacity: 0; transform: scale(0.6); }
    40% { opacity: 0.85; }
    100% { opacity: 0.45; transform: scale(1); }
  }
  @keyframes bit-drift {
    0% { transform: translateY(0); opacity: 0.45; }
    100% { transform: translateY(-60px); opacity: 0.15; }
  }
  @keyframes solvy-in {
    0% { opacity: 0; filter: blur(28px); transform: scale(0.82); }
    60% { opacity: 0.85; filter: blur(6px); }
    100% { opacity: 1; filter: blur(0); transform: scale(1); }
  }
  @keyframes solvy-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }
  @keyframes eye-on {
    0% { opacity: 0; transform: scaleY(0.2); }
    35% { opacity: 1; transform: scaleY(1.15); }
    100% { opacity: 0.85; transform: scaleY(1); }
  }
  @keyframes flare {
    0% { opacity: 0; transform: scaleX(0.2); }
    30% { opacity: 1; transform: scaleX(1); }
    100% { opacity: 0; transform: scaleX(0.6); }
  }
  @keyframes beam-x {
    0% { opacity: 1; transform: scaleX(0); }
    55% { opacity: 1; transform: scaleX(1); }
    100% { opacity: 0; transform: scaleX(1); }
  }
  @keyframes beam-y {
    0% { opacity: 1; transform: scaleY(0); }
    55% { opacity: 1; transform: scaleY(1); }
    100% { opacity: 0; transform: scaleY(1); }
  }
  @keyframes logo-in {
    0% { opacity: 0; filter: blur(12px); transform: scale(0.94); }
    100% { opacity: 1; filter: blur(0); transform: scale(1); }
  }
  @keyframes burst {
    0% { opacity: 0; transform: scale(0.4); }
    25% { opacity: 1; transform: scale(1.1); }
    100% { opacity: 0.25; transform: scale(1.5); }
  }
  @keyframes progress {
    to { transform: scaleX(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-gate { display: none; }
  }
</style>

<script>
  const DURATION = 8000; // ms — la secuencia completa
  const FADE = 700; // ms — fundido hacia la web (dentro de los 8 s)

  const gate = document.getElementById('intro-gate') as HTMLElement | null;
  const solvy = document.getElementById('intro-solvy-img') as HTMLImageElement | null;
  const skipBtn = document.getElementById('intro-skip') as HTMLButtonElement | null;

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Play the intro on a real entrance (reload, direct visit, external link) but
  // NOT when navigating back home from another page of the site.
  const navEntry = performance.getEntriesByType('navigation')[0] as
    | PerformanceNavigationTiming
    | undefined;
  const cameFromSite = (() => {
    try {
      return !!document.referrer && new URL(document.referrer).origin === location.origin;
    } catch {
      return false;
    }
  })();
  const internalNav = navEntry?.type !== 'reload' && cameFromSite;

  function unlock() {
    document.documentElement.style.overflow = '';
    document.body.style.overflow = '';
  }

  let timer = 0;

  function dismiss() {
    if (!gate || gate.classList.contains('is-leaving')) return;
    window.clearTimeout(timer);
    gate.classList.add('is-leaving');
    window.scrollTo(0, 0); // reveal the hero, never a mid-page section
    unlock();
    window.setTimeout(() => gate.classList.add('is-done'), FADE);
  }

  if (!gate || reduce || internalNav) {
    // Nothing to show — make sure the page is scrollable and the gate is gone.
    if (gate) gate.classList.add('is-done');
    unlock();
  } else {
    // The reveal must land on the HERO: stop the browser from restoring the
    // previous scroll position on reload and pin the viewport to the top.
    try {
      history.scrollRestoration = 'manual';
    } catch {
      /* unsupported */
    }
    window.scrollTo(0, 0);

    // Lock scroll while the intro plays.
    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';

    // Arranca la línea de tiempo cuando el render de Solvy ya se puede pintar
    // (máx. 1,5 s de espera para no bloquear con una red lenta).
    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      gate.classList.add('is-playing');
      timer = window.setTimeout(dismiss, DURATION - FADE);
    };
    (solvy?.decode() ?? Promise.resolve()).then(start, start);
    window.setTimeout(start, 1500);

    skipBtn?.addEventListener('click', dismiss);
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') dismiss();
    });
  }
</script>
