---
import Button from '../ui/Button.astro';
import { getAuditCopy, auditPaths } from '@/data/audit';
import { defaultLocale, type Locale } from '@/i18n';

/* Home teaser for the free AI audit lead magnet. */
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const c = getAuditCopy(locale).homeCta;
const href = auditPaths[locale].form;
---

<section class="py-12 sm:py-16">
  <div class="mx-auto max-w-[1240px] px-4 sm:px-6">
    <div
      data-reveal
      class="card-3d relative flex flex-col gap-6 overflow-hidden rounded-[var(--radius-xl2)] border border-border bg-canvas p-6 sm:p-10 lg:flex-row lg:items-center lg:justify-between"
    >
      <div class="pointer-events-none absolute -right-20 -top-24 size-72 rounded-full bg-[var(--color-brand-glow)]/20 blur-3xl" aria-hidden="true"></div>
      <div class="relative flex max-w-2xl flex-col gap-3">
        <span class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.18em] text-brand">
          <span class="h-px w-6 bg-brand"></span>
          {c.eyebrow}
        </span>
        <h2 class="text-[clamp(1.6rem,3.4vw,2.4rem)] leading-[1.1] text-ink">{c.title}</h2>
        <p class="leading-relaxed text-muted" style="max-width: 60ch;">{c.text}</p>
      </div>
      <Button href={href} size="lg" icon="arrow" class="relative shrink-0">{c.cta}</Button>
    </div>
  </div>
</section>
