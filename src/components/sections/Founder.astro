---
import Icon from '../ui/Icon.astro';
import { getDict, defaultLocale, type Locale } from '@/i18n';

/* Team section (/nosotros, /en/about): one card per person, in the order of
   `team` in src/data/site.ts. Same layout as the original founder card. */
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const { team, ui } = getDict(locale);

const linkClass =
  'press inline-flex items-center gap-2 rounded-full border border-border bg-canvas px-4 py-2 text-sm font-medium text-ink-soft transition-colors hover:bg-surface-2 hover:text-ink';
---

<section id="fundador" class="scroll-mt-24 py-[var(--spacing-section)]">
  <div class="mx-auto flex max-w-[1240px] flex-col gap-6 px-4 sm:px-6">
    <span data-reveal class="text-sm font-semibold uppercase tracking-[0.16em] text-brand">
      {ui.founderUi.eyebrow}
    </span>

    {
      team.map((m) => (
        <article
          id={m.id}
          data-reveal="scale"
          class="card-3d grid scroll-mt-28 gap-8 rounded-[var(--radius-xl2)] border border-border bg-surface p-7 sm:p-10 md:grid-cols-[auto_1fr] md:gap-12"
        >
          <div class="flex items-center gap-4 md:w-48 md:flex-col md:items-start md:gap-4">
            <img
              src={m.avatar}
              alt={m.name}
              width="160"
              height="160"
              loading="lazy"
              decoding="async"
              class="size-20 shrink-0 rounded-2xl object-cover shadow-[var(--shadow-soft)] ring-1 ring-border"
            />
            <div class="md:mt-1">
              <h2 class="font-display text-lg font-semibold text-ink">{m.name}</h2>
              <p class="text-sm text-muted">{m.role}</p>
            </div>
          </div>

          <div class="flex flex-col gap-5">
            <p class="prose-justify text-lg leading-relaxed text-ink-soft">{m.bio}</p>

            <ul class="flex flex-wrap gap-2">
              {m.highlights.map((h) => (
                <li class="inline-flex items-center gap-1.5 rounded-full bg-canvas px-3 py-1.5 text-xs font-medium text-ink-soft ring-1 ring-border">
                  <Icon name="check" class="size-3.5 text-brand" />
                  {h}
                </li>
              ))}
            </ul>

            {(m.linkedin || m.github) && (
              <div class="flex flex-wrap items-center gap-3 pt-1">
                {m.linkedin && (
                  <a href={m.linkedin} target="_blank" rel="noopener noreferrer" class={linkClass}>
                    LinkedIn
                    <Icon name="arrow" class="size-4" />
                  </a>
                )}
                {m.github && (
                  <a href={m.github} target="_blank" rel="noopener noreferrer" class={linkClass}>
                    GitHub
                    <Icon name="arrow" class="size-4" />
                  </a>
                )}
              </div>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
