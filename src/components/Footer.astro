---
import Icon from './ui/Icon.astro';
import SocialLinks from './ui/SocialLinks.astro';
import { getDict, defaultLocale, type Locale } from '@/i18n';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const { brand, footer, ui } = getDict(locale);
---

<footer class="border-t border-border bg-surface">
  <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr]">
      <div class="flex flex-col gap-5">
        <img
          src={brand.logo3d}
          alt={brand.name}
          class="h-12 w-auto self-start"
          width="441"
          height="233"
          style="transform: scaleX(1.14); transform-origin: left center;"
        />
        <p class="max-w-sm leading-relaxed text-muted">{footer.blurb}</p>
        <div class="flex flex-col gap-2 text-sm text-ink-soft">
          <a href={`mailto:${brand.email}`} class="inline-flex w-fit items-center gap-2 hover:text-brand">
            <Icon name="mail" class="size-4" />
            {brand.email}
          </a>
          {
            brand.locations.map((loc) => (
              <span class="inline-flex items-center gap-2">
                <Icon name="pin" class="size-4 text-muted" />
                {loc}
              </span>
            ))
          }
        </div>
      </div>

      {
        footer.columns.map((col) => (
          <nav class="flex flex-col gap-3">
            <h3 class="font-display text-sm uppercase tracking-[0.14em] text-muted">
              {col.title}
            </h3>
            <ul class="flex flex-col gap-2.5">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-ink-soft transition-colors hover:text-brand"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="mt-14 flex flex-col gap-4 border-t border-border pt-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {new Date().getFullYear()} {brand.name}. {ui.footerUi.rights}</p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
      <ul class="flex flex-wrap gap-5">
        <li>
          <a href={locale === 'en' ? '/en/privacy/' : '/privacidad/'} class="transition-colors hover:text-ink">
            {locale === 'en' ? 'Privacy' : 'Privacidad'}
          </a>
        </li>
        {import.meta.env.PUBLIC_POSTHOG_KEY && (
          <li>
            <a href="#cookies" data-open-consent class="transition-colors hover:text-ink">
              Cookies
            </a>
          </li>
        )}
      </ul>
      <SocialLinks variant="inline" />
      </div>
    </div>
  </div>
</footer>
