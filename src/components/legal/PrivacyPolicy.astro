---
import { brand } from '@/data/site';
import { defaultLocale, type Locale } from '@/i18n';

/* Privacy policy (RGPD / LOPDGDD). Review with your legal advisor and add the
   controller's legal name + tax ID (NIF) before relying on it. */
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
// Fecha de la última revisión (texto mostrado en cada idioma).
const updatedEs = '8 de noviembre de 2026';
const updatedEn = 'November 8, 2026';

type Section = { id?: string; h: string; p: string[] };

const es: { eyebrow: string; title: string; updated: string; sections: Section[] } = {
  eyebrow: 'Legal',
  title: 'Política de privacidad',
  updated: `Última actualización: ${updatedEs}`,
  sections: [
    {
      h: 'Responsable del tratamiento',
      p: [`${brand.name} (${brand.locations[0]}). Contacto para cualquier cuestión de privacidad: ${brand.email}.`],
    },
    {
      h: 'Qué datos tratamos',
      p: [
        'Auditoría IA Gratis: URL de tu negocio, nombre, email, sector, el contenido público de tu web que analizamos y un identificador cifrado (hash) de tu IP para limitar abusos.',
        'Formulario de contacto: nombre, email, empresa, tipo de proyecto y mensaje.',
        'Reservas de llamada (Cal.com): nombre, email, fecha y notas de la reserva.',
        'Chat con Solvy (asistente de IA): los mensajes que escribes. Solo si marcas la casilla de consentimiento guardamos tu nombre, email y los datos de tu consulta (empresa, sector, necesidad, urgencia y presupuesto aproximado). Sin esa casilla no guardamos ningún dato personal.',
      ],
    },
    {
      h: 'Para qué y con qué base legal',
      p: [
        'Generar y enviarte la auditoría, responder a tu solicitud y contactarte sobre ella. Base legal: tu consentimiento (art. 6.1.a RGPD) y la aplicación de medidas precontractuales a petición tuya (art. 6.1.b).',
        'Prevenir spam y abusos mediante límites de uso. Base legal: interés legítimo (art. 6.1.f).',
        'No vendemos tus datos ni los usamos para decisiones automatizadas con efectos jurídicos. La puntuación de la auditoría es orientativa.',
      ],
    },
    {
      h: 'Proveedores (encargados del tratamiento)',
      p: [
        'Netlify (alojamiento web), Supabase (base de datos, UE), Anthropic (análisis con IA del contenido público de tu web y respuestas del asistente Solvy), Resend (envío de emails), Slack (avisos internos al equipo), Cal.com (reservas) y PostHog (analítica web, servidores en la UE). Algunos pueden tratar datos fuera del EEE con las garantías adecuadas (cláusulas contractuales tipo / Data Privacy Framework).',
      ],
    },
    {
      id: 'cookies',
      h: 'Cookies y Analítica',
      p: [
        'Sin tu permiso solo medimos visitas de forma anónima, sin guardar nada en tu dispositivo: páginas vistas, clics en botones y hasta dónde haces scroll, para saber qué funciona.',
        'Si aceptas en el aviso de cookies, PostHog guarda un identificador en tu navegador (cookie y localStorage, prefijo "ph_", hasta 12 meses) para reconocer tu visita y graba sesiones anonimizadas en las que los campos de los formularios siempre se ocultan. Si después envías un formulario, podemos asociar esa visita a tu solicitud.',
        'También guardamos durante la visita (sessionStorage, se borra al cerrar la pestaña) de dónde llegaste —campaña o web de origen— y lo adjuntamos a tus solicitudes. Puedes cambiar tu elección en cualquier momento desde el enlace "Cookies" del pie de página.',
      ],
    },
    {
      h: 'Cuánto tiempo los conservamos',
      p: [
        'Mientras exista la relación comercial o hasta que retires tu consentimiento y, como máximo, 24 meses desde el último contacto. Los registros anti-abuso se borran a los 30 días.',
        'Las conversaciones con Solvy se guardan de forma anónima (eliminamos emails y teléfonos antes de guardarlas) durante 30 días para mejorar el asistente, y después se borran.',
      ],
    },
    {
      h: 'Tus derechos',
      p: [
        `Puedes acceder, rectificar, suprimir, oponerte, limitar el tratamiento, solicitar la portabilidad y retirar tu consentimiento en cualquier momento escribiendo a ${brand.email}. Si consideras que no hemos atendido tu solicitud, puedes reclamar ante la Agencia Española de Protección de Datos (aepd.es).`,
      ],
    },
  ],
};

const en: typeof es = {
  eyebrow: 'Legal',
  title: 'Privacy policy',
  updated: `Last updated: ${updatedEn}`,
  sections: [
    { h: 'Data controller', p: [`${brand.name} (Madrid, Spain). Privacy contact: ${brand.email}.`] },
    {
      h: 'What data we process',
      p: [
        'Free AI Audit: your business URL, name, email, industry, the public content of your website that we analyze, and a hashed identifier of your IP address to prevent abuse.',
        'Contact form: name, email, company, project type and message.',
        'Call bookings (Cal.com): name, email, booking time and notes.',
        'Chat with Solvy (AI assistant): the messages you type. Only if you tick the consent box do we store your name, email and the details of your enquiry (company, sector, need, urgency and rough budget). Without that box we store no personal data.',
      ],
    },
    {
      h: 'Purposes and legal basis',
      p: [
        'To produce and send you the audit, answer your request and contact you about it. Legal basis: your consent (Art. 6(1)(a) GDPR) and steps taken at your request prior to a contract (Art. 6(1)(b)).',
        'To prevent spam and abuse through usage limits. Legal basis: legitimate interest (Art. 6(1)(f)).',
        'We do not sell your data or use it for automated decisions with legal effects. The audit score is indicative only.',
      ],
    },
    {
      h: 'Service providers (processors)',
      p: [
        'Netlify (hosting), Supabase (database, EU), Anthropic (AI analysis of your public website content and the Solvy assistant’s replies), Resend (email delivery), Slack (internal team alerts), Cal.com (bookings) and PostHog (web analytics, EU servers). Some may process data outside the EEA under appropriate safeguards (Standard Contractual Clauses / Data Privacy Framework).',
      ],
    },
    {
      id: 'cookies',
      h: 'Cookies & Analytics',
      p: [
        'Without your permission we only measure visits anonymously, storing nothing on your device: pages viewed, button clicks and scroll depth, so we know what works.',
        'If you accept in the cookie notice, PostHog stores an identifier in your browser (cookie and localStorage, prefix "ph_", up to 12 months) to recognize your visit and records anonymized sessions in which form fields are always hidden. If you then submit a form, we may link that visit to your request.',
        'During your visit we also keep (sessionStorage, cleared when you close the tab) where you came from — campaign or referring site — and attach it to your requests. You can change your choice at any time from the "Cookies" link in the footer.',
      ],
    },
    {
      h: 'Retention',
      p: [
        'For as long as the business relationship lasts or until you withdraw consent, and at most 24 months after our last contact. Anti-abuse records are deleted after 30 days.',
        'Conversations with Solvy are stored anonymously (we remove emails and phone numbers before saving them) for 30 days to improve the assistant, then deleted.',
      ],
    },
    {
      h: 'Your rights',
      p: [
        `You can access, rectify, erase, object, restrict processing, request portability and withdraw consent at any time by writing to ${brand.email}. You may also lodge a complaint with the Spanish Data Protection Agency (aepd.es).`,
      ],
    },
  ],
};

const c = locale === 'en' ? en : es;
---

<section class="relative bg-surface pb-[var(--spacing-section)] pt-32 sm:pt-36">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <span class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.18em] text-brand">
      <span class="h-px w-6 bg-brand"></span>
      {c.eyebrow}
    </span>
    <h1 class="mt-4 text-[clamp(2.2rem,5vw,3.4rem)] leading-[1.05] text-ink">{c.title}</h1>
    <p class="mt-3 text-sm text-muted">{c.updated}</p>
    <div class="mt-10 flex flex-col gap-9">
      {
        c.sections.map((s) => (
          <section id={s.id} class="flex scroll-mt-28 flex-col gap-3">
            <h2 class="font-display text-xl text-ink sm:text-2xl">{s.h}</h2>
            {s.p.map((para) => (
              <p class="leading-relaxed text-muted" style="max-width: 70ch;">
                {para}
              </p>
            ))}
          </section>
        ))
      }
    </div>
  </div>
</section>
