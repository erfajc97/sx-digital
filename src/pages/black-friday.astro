---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { brand } from '@/data/site';

/* Black Friday campaign landing — the link in the 24 Nov videos.
   One goal: open WhatsApp. No intro gate, no full nav (same pattern as
   /agendar). Kept out of search (noindex + excluded from the sitemap in
   astro.config.mjs): it is a time-limited offer reached from social videos,
   and once it expires an indexed copy would only show a dead offer.

   Clicks on the WhatsApp buttons are tracked automatically as
   `whatsapp_click` by src/scripts/analytics.ts, with `section` set to the
   section id below (bf-oferta = top button, bf-cierre = bottom button). */

/* The offer. Margin logic: the discount is paid for by what we get back —
   a 50 % upfront payment (cash before the slow December), a commitment
   by 30 Nov (closes the pipeline fast) and a capped number of slots
   (the discount can't eat the whole quarter), plus a minimum project size
   so small jobs don't go out at a loss. Edit here if anything changes. */
const offer = {
  headline: '−20 % en tu proyecto de IA o web a medida',
  deadline: 'lunes 30 de noviembre',
  conditions:
    'Para proyectos desde 1.200 € (o $1,200 USD) confirmados con un 50 % por adelantado antes de esa fecha y que arranquen antes del 31 de enero. El anticipo se descuenta del total.',
  // Real limit: after each signed project, raise `slotsTaken` and redeploy.
  // At 10 the page switches to "offer closed" on its own.
  slotsTotal: 10,
  slotsTaken: 0,
  // End of Monday 30 Nov, Madrid time. After this the page shows the closed
  // state in the browser, even without a redeploy.
  endsAt: '2026-12-01T00:00:00+01:00',
};

const slotsLeft = Math.max(0, offer.slotsTotal - offer.slotsTaken);
const slotsLabel =
  offer.slotsTaken === 0 ? `Solo ${offer.slotsTotal} plazas` : `Quedan ${slotsLeft} de ${offer.slotsTotal} plazas`;
const closed = slotsLeft === 0 || Date.now() >= Date.parse(offer.endsAt);
const closedReason = slotsLeft === 0 ? 'Plazas agotadas' : 'Oferta terminada';

const waClosedText = 'Hola, vengo del vídeo de Black Friday. Sé que la oferta ha terminado, pero me interesa un presupuesto';
const waClosedHref = `https://wa.me/${(brand.whatsapp ?? brand.phone).replace(/\D/g, '')}?text=${encodeURIComponent(waClosedText)}`;

const number = (brand.whatsapp ?? brand.phone).replace(/\D/g, '');
const waText = 'Hola, vengo del vídeo de Black Friday y quiero info sobre la oferta';
const waHref = `https://wa.me/${number}?text=${encodeURIComponent(waText)}`;

const title = `Black Friday | ${brand.name}`;
const description =
  'Black Friday en SolvyX: −20 % en tu proyecto de automatización con IA o web a medida. Solo 10 plazas, hasta el 30 de noviembre. Escríbenos por WhatsApp.';

const steps = [
  { n: '1', title: 'Escríbenos por WhatsApp', text: 'Cuéntanos tu negocio en un par de líneas. Te respondemos el mismo día.' },
  { n: '2', title: 'Llamada de 30 minutos', text: 'Vemos qué te conviene automatizar o construir, sin compromiso.' },
  { n: '3', title: 'Presupuesto cerrado en 24 h', text: 'Con la oferta de Black Friday aplicada y sin sorpresas después.' },
];
---

<BaseLayout title={title} description={description} noindex>
  <div class="flex min-h-screen flex-col bg-surface">
    <!-- Minimal header -->
    <header class="border-b border-border bg-canvas/80 backdrop-blur">
      <div class="mx-auto flex max-w-[1100px] items-center justify-between px-4 py-3 sm:px-6">
        <a href="/" class="press flex items-center" aria-label={`${brand.name} — inicio`}>
          <img
            src={brand.logo3d}
            alt={brand.name}
            class="h-9 w-auto sm:h-11"
            width="441"
            height="233"
            style="transform: scaleX(1.1); transform-origin: left center;"
          />
        </a>
        <span class="text-xs font-semibold uppercase tracking-[0.18em] text-brand">Black Friday</span>
      </div>
    </header>

    <main class="flex-1">
      <!-- Closed state: slots sold out or deadline passed (swapped in by the
           script below when the deadline passes after the last deploy). -->
      <section id="bf-terminada" data-bf-closed hidden={!closed} class="px-4 pb-16 pt-12 sm:px-6 sm:pt-20">
        <div class="mx-auto flex max-w-2xl flex-col items-center gap-5 text-center">
          <span
            class="inline-flex items-center rounded-full border border-border-strong bg-canvas px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-ink"
          >
            Black Friday ·&nbsp;<span data-bf-reason>{closedReason}</span>
          </span>
          <h1 class="text-[clamp(1.9rem,6vw,3.2rem)] leading-[1.08] text-ink">
            La oferta de Black Friday ha terminado
          </h1>
          <p class="text-base leading-relaxed text-muted sm:text-lg" style="max-width: 46ch;">
            Gracias a todos los que habéis escrito. Si quieres automatizar con IA o lanzar tu web o app,
            escríbenos igualmente: tras una llamada de 30 minutos te enviamos un presupuesto cerrado en 24 h.
          </p>
          <a
            href={waClosedHref}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-3d btn-neon inline-flex w-full items-center justify-center gap-2.5 rounded-full px-7 py-4 text-base font-semibold sm:w-auto"
          >
            Escribir por WhatsApp
          </a>
        </div>
      </section>

      <div data-bf-open hidden={closed}>
      <!-- Offer + main CTA: everything above the fold on a 375px phone -->
      <section id="bf-oferta" class="px-4 pb-12 pt-8 sm:px-6 sm:pb-16 sm:pt-16">
        <div class="mx-auto flex max-w-2xl flex-col items-center gap-5 text-center">
          <span
            class="inline-flex items-center rounded-full border border-border-strong bg-canvas px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-ink"
          >
            Black Friday · {slotsLabel}
          </span>
          <h1 class="text-[clamp(1.9rem,6vw,3.4rem)] leading-[1.06] text-ink">
            <span class="text-gradient">{offer.headline}</span>
          </h1>
          <p class="text-base leading-relaxed text-muted sm:text-lg" style="max-width: 46ch;">
            Para negocios que quieren automatizar con IA, captar más leads o lanzar su web o app
            a medida, en días y no en meses.
          </p>
          <a
            href={waHref}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-3d btn-neon inline-flex w-full items-center justify-center gap-2.5 rounded-full px-7 py-4 text-base font-semibold sm:w-auto"
          >
            <svg viewBox="0 0 32 32" class="size-5" aria-hidden="true" fill="currentColor">
              <path
                d="M16.04 3C8.86 3 3.03 8.82 3.03 16c0 2.3.6 4.53 1.74 6.5L3 29l6.68-1.75A12.94 12.94 0 0 0 16.04 29C23.2 29 29 23.18 29 16S23.2 3 16.04 3Zm0 23.7c-1.98 0-3.92-.53-5.61-1.53l-.4-.24-3.96 1.04 1.06-3.86-.26-.4A10.66 10.66 0 0 1 5.33 16c0-5.9 4.8-10.7 10.71-10.7 5.9 0 10.66 4.8 10.66 10.7 0 5.9-4.77 10.7-10.66 10.7Zm5.86-8c-.32-.16-1.9-.94-2.2-1.05-.29-.1-.5-.16-.72.16-.21.32-.82 1.04-1 1.26-.19.21-.37.24-.69.08-.32-.16-1.36-.5-2.59-1.6-.96-.85-1.6-1.9-1.79-2.22-.19-.32-.02-.5.14-.65.15-.15.32-.37.48-.56.16-.19.21-.32.32-.53.1-.21.05-.4-.03-.56-.08-.16-.72-1.73-.98-2.37-.26-.62-.52-.54-.72-.55h-.61c-.21 0-.56.08-.85.4-.29.32-1.12 1.09-1.12 2.66 0 1.57 1.14 3.09 1.3 3.3.16.21 2.25 3.43 5.45 4.81.76.33 1.36.53 1.82.67.77.24 1.46.21 2.01.13.61-.09 1.9-.78 2.16-1.53.27-.75.27-1.39.19-1.53-.08-.13-.29-.21-.61-.37Z"
              ></path>
            </svg>
            Quiero la oferta por WhatsApp
          </a>
          <p class="text-sm text-muted">
            Válido hasta el {offer.deadline}. {offer.conditions}
          </p>
        </div>
      </section>

      <!-- How it works -->
      <section id="bf-pasos" class="px-4 pb-12 sm:px-6 sm:pb-16">
        <ol class="mx-auto grid max-w-[1000px] gap-4 sm:grid-cols-3">
          {
            steps.map((s) => (
              <li class="card-3d rounded-[var(--radius-xl2)] border border-border bg-canvas p-5 sm:p-6">
                <span class="text-gradient font-display text-2xl font-semibold">{s.n}</span>
                <h2 class="mt-2 text-lg leading-snug text-ink">{s.title}</h2>
                <p class="mt-1.5 text-sm leading-relaxed text-muted">{s.text}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- Closing CTA (repeat) -->
      <section id="bf-cierre" class="px-4 pb-14 sm:px-6 sm:pb-20">
        <div
          class="relative mx-auto max-w-[1000px] overflow-hidden rounded-[var(--radius-xl2)] panel-neon px-6 py-12 text-center sm:px-12 sm:py-16"
        >
          <h2 class="text-[clamp(1.6rem,4vw,2.4rem)] leading-[1.1] text-white">
            La oferta acaba el {offer.deadline}
          </h2>
          <p class="mx-auto mt-3 text-base leading-relaxed text-white/85" style="max-width: 44ch;">
            {slotsLabel}. Escríbenos ahora y reserva la tuya: la llamada es sin compromiso.
          </p>
          <a
            href={waHref}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-3d mt-7 inline-flex w-full items-center justify-center gap-2.5 rounded-full bg-ink px-7 py-4 text-base font-semibold text-canvas hover:bg-ink-soft sm:w-auto"
          >
            Escribir por WhatsApp
          </a>
        </div>
      </section>
      </div>
    </main>

    <footer class="border-t border-border py-5">
      <p class="text-center text-xs text-muted">
        © {new Date().getFullYear()} {brand.name} ·
        <a href="/" class="underline-offset-2 hover:text-ink hover:underline">Ver la web completa</a>
      </p>
    </footer>
  </div>

  <!-- The site is static: if the deadline passes after the last deploy,
       switch to the closed state in the browser so nobody sees a dead offer. -->
  <script is:inline define:vars={{ endsAt: offer.endsAt }}>
    if (Date.now() >= Date.parse(endsAt)) {
      document.querySelector('[data-bf-open]')?.setAttribute('hidden', '');
      document.querySelector('[data-bf-closed]')?.removeAttribute('hidden');
      const reason = document.querySelector('[data-bf-reason]');
      if (reason) reason.textContent = 'Oferta terminada';
    }
  </script>
</BaseLayout>
